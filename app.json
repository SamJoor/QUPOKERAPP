{
  "expo": {
    "name": "QU Poker",
    "slug": "qu-poker",
    "scheme": "qupoker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#041126"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qupoker.strategyclub",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is used to scan club event QR codes for attendance check-in.",
        "NSPhotoLibraryUsageDescription": "Photo library access is used only when you choose a profile photo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qupoker.strategyclub",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#041126"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#041126"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Camera access is used to scan club event QR codes for attendance check-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo library access is used only when you choose a profile photo."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "supportUrl": "https://qupoker.app/support",
      "privacyPolicyUrl": "https://qupoker.app/privacy",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7f59cfae-ff54-468d-b43b-9c618cd3782b"
      }
    },
    "owner": "samjoor50"
  }
}
