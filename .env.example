EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# No web app exists yet, so invite links have no landing page to resolve to. Point this at
# a real host before relying on shared invite URLs; qupoker.app is NOT registered.
EXPO_PUBLIC_INVITE_BASE_URL=https://samjoor.github.io/QUPOKERAPP
EXPO_PUBLIC_APP_STORE_URL=

# Optional: run on offline fixtures with no backend. Never set this in a release build.
# EXPO_PUBLIC_DEMO_MODE=1
